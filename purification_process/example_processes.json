    "creation_date": "2024-10-12T00:00:00",
    "steps": [
      {
        "step_name": "Equilibration",
        "step_type": "equilibration",
        "volume": 5000,
        "flowrate": 1000,
        "inlet_valve": 1,
        "outlet_valve": 1,
        "prime_pump": true,
        "prime_volume": 500,
        "wait_until_complete": true,
        "description": "Equilibrate column with PBS buffer at 1000 µL/min"
      },
      {
        "step_name": "Sample Application",
        "step_type": "sample_application",
        "volume": 2000,
        "flowrate": 500,
        "inlet_valve": 2,
        "outlet_valve": 1,
        "prime_pump": true,
        "prime_volume": 200,
        "wait_until_complete": true,
        "description": "Apply sample containing antibodies at 500 µL/min"
      },
      {
        "step_name": "Wash 1 - PBS",
        "step_type": "wash",
        "volume": 3000,
        "flowrate": 1500,
        "inlet_valve": 3,
        "outlet_valve": 1,
        "prime_pump": false,
        "prime_volume": null,
        "wait_until_complete": true,
        "description": "Wash with PBS to remove unbound proteins"
      },
      {
        "step_name": "Wash 2 - Salt",
        "step_type": "wash",
        "volume": 2000,
        "flowrate": 1000,
        "inlet_valve": 4,
        "outlet_valve": 1,
        "prime_pump": true,
        "prime_volume": 200,
        "wait_until_complete": true,
        "description": "High salt wash to remove non-specifically bound proteins"
      },
      {
        "step_name": "Elution",
        "step_type": "elution",
        "volume": 1500,
        "flowrate": 300,
        "inlet_valve": 5,
        "outlet_valve": 2,
        "prime_pump": true,
        "prime_volume": 150,
        "wait_until_complete": true,
        "description": "Elute purified antibodies with low pH buffer"
      },
      {
        "step_name": "Regeneration",
        "step_type": "cleaning",
        "volume": 3000,
        "flowrate": 1500,
        "inlet_valve": 6,
        "outlet_valve": 1,
        "prime_pump": true,
        "prime_volume": 300,
        "wait_until_complete": true,
        "description": "Regenerate column with NaOH solution"
      },
      {
        "step_name": "Storage Buffer",
        "step_type": "equilibration",
        "volume": 2000,
        "flowrate": 1000,
        "inlet_valve": 7,
        "outlet_valve": 1,
        "prime_pump": false,
        "prime_volume": null,
        "wait_until_complete": true,
        "description": "Condition column with storage buffer"
      }
    ]
  },
